# Copy to .env.local (never commit). Read ONLY on the server; never sent to the browser.
# Fine-grained PAT, scoped per repository:
#   intern repo: Pull requests: Read, Contents: Read
#   org repo:    Pull requests: Read & write, Contents: Read & write (to push the transfer branch via API-less git you only need git credentials)
GITHUB_TOKEN_INTERN=
GITHUB_TOKEN_ORG=
# Fallback used when a role-specific token is not set
GITHUB_TOKEN=
# GitHub Enterprise Server (optional)
# GITHUB_API_URL=https://api.github.com
# Where config/state/operation logs are stored (default: ./.git-repo-sync)
# GIT_REPO_SYNC_DATA_DIR=
